# Neon Postgres — Vercel tự đổ biến này khi bạn gắn Neon ở tab Storage.
# Chạy máy cá nhân thì copy connection string từ bảng điều khiển Neon vào .env.local
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Mật khẩu đăng nhập trang /admin (bắt buộc)
ADMIN_PASSWORD="doi-mat-khau-nay"

# Khoá ký cookie phiên đăng nhập. Nên đặt bằng chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bỏ trống cũng chạy được (khoá sẽ dẫn xuất từ ADMIN_PASSWORD).
AUTH_SECRET=""
